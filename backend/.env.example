# Copier en .env et adapter. Ne jamais versionner .env.
PME360_ENV=dev
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=a-remplacer
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3010
POSTGRES_DB=pme360
POSTGRES_USER=pme360
POSTGRES_PASSWORD=pme360-dev-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5442
REDIS_URL=redis://localhost:6390/0
EMAIL_HOST=localhost
EMAIL_PORT=1035
PME360_FRONTEND_URL=http://localhost:3010
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PME360_FIELD_ENCRYPTION_KEYS=a-remplacer
# Clé maîtresse du chiffrement des fichiers (clé Fernet). À SAUVEGARDER HORS DES DONNÉES : sans elle, aucun fichier
# n'est relisible. Rotation : ajouter la nouvelle clé EN TÊTE (séparateur virgule), puis « manage.py storage_keys rewrap ».
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PME360_STORAGE_MASTER_KEYS=a-remplacer
PME360_MFA_ENFORCED=true
# Limitation de débit de l authentification (défaut : 10/min et 5/min)
# PME360_AUTH_RATE=10/min
# PME360_OTP_RATE=5/min
# PME360_OTP_MAX_PER_HOUR=5

# Stockage objet (MinIO en développement)
PME360_STORAGE_BACKEND=s3
PME360_S3_ENDPOINT=http://localhost:9010
PME360_S3_BUCKET=pme360-documents
PME360_S3_ACCESS_KEY=pme360
PME360_S3_SECRET_KEY=pme360-dev-only
# Antivirus : clamd (production) ou eicar (développement sans ClamAV)
PME360_ANTIVIRUS=eicar
PME360_CLAMD_HOST=localhost
PME360_CLAMD_PORT=3310

# IA (Document 4 ; décision D-03). « local » = moteur de règles, aucune donnée envoyée à l'extérieur.
# Pour Claude : PME360_AI_PROVIDER=anthropic + ANTHROPIC_API_KEY, puis autoriser l'IA externe par organisation.
PME360_AI_PROVIDER=local
ANTHROPIC_API_KEY=
